<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="MenuTheme.uss" />

    <ui:VisualElement class="scroll-container-root">
        <ui:Label name="ScrollTitle" text="Document Title" class="scroll-container-title" />
        
        <ui:ScrollView name="ScrollContent" class="scroll-container-view" vertical-scroller-visibility="AlwaysVisible">
            <ui:Label name="ScrollText" text="Content goes here..." class="scroll-content-text" />
        </ui:ScrollView>

        <ui:Button name="ScrollCloseBtn" text="Close" class="settings-back-btn" style="align-self: center;" />
    </ui:VisualElement>

</ui:UXML>
