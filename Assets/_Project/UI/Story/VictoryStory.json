            "waitUntilFinished": true
        },
        {
            "type": "Dialogue",
            "actor": "Garlic Sage",
            "params": {
                "text": "I would love to, but my union contract clearly states I only fight on Tuesdays. Today is Wednesday, intern. My hands are tied."
