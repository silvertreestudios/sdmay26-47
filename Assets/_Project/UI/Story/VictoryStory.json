            "waitUntilFinished": true
        },
        {
            "type": "Dialogue",
            "actor": "Garlic Sage",
            "params": {
                "text": "The next level has even more synergies to explore! And by synergies, I mean even bigger skeletons with pointier swords. Don't worry, your stapler is still under warranty!"
