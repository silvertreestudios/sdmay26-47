        {
            "type": "Dialogue",
            "actor": "Garlic Sage",
            "params": {
                "text": "Fascinating! They've synergized into Skeleton Shawerma Thieves! Talk about an agile workflow! They really adapted to market disruptions!"
            },
            "waitUntilFinished": true
        },
        {
            "type": "Dialogue",
            "actor": "Player",
            "params": {
                "text": "This isn't an agile workflow, this is a nightmare! Look at their glowing red eyes!"
