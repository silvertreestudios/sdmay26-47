    Path: flags.pf2e.sneakAttackDamage.number
    Mode: override
    Value: '"ternary(lt(@actor.level, 5), 1, ternary(lt(@actor.level, 11), 2, ternary(lt(@actor.level,
      17), 3, 4)))"'
