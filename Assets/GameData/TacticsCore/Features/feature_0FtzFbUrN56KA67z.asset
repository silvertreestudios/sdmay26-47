    Json: '{"choices":[{"label":"PF2E.SpecificRule.Barbarian.Animal.Ankylosaurus","value":"ankylosaurus"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Ant","value":"ant"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Ape","value":"ape"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Bat","value":"bat"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Bear","value":"bear"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Bird","value":"bird"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Brontosaurus","value":"brontosaurus"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Bull","value":"bull"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Cat","value":"cat"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Crab","value":"crab"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Crocodile","value":"crocodile"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Deer","value":"deer"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Frog","value":"frog"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Orca","value":"orca"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Scorpion","value":"scorpion"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Seal","value":"seal"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Shark","value":"shark"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Snake","value":"snake"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Spider","value":"spider"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Tyrannosaurus","value":"tyrannosaurus"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Wasp","value":"wasp"},{"label":"PF2E.SpecificRule.Barbarian.Animal.Wolf","value":"wolf"}],"key":"ChoiceSet","prompt":"PF2E.SpecificRule.Barbarian.Animal.Prompt","rollOption":"animal-instinct"}'
