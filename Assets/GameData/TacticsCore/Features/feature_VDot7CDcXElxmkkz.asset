"damageType":"acid","dragonType":"black","tradition":"arcane"}},{"label":"PF2E.Dragon.Blue","value":{"damageType":"electricity","dragonType":"blue","tradition":"arcane"}},{"label":"PF2E.Dragon.Brass","value":{"damageType":"fire","dragonType":"brass","tradition":"arcane"}},{"label":"PF2E.Dragon.Bronze","value":{"damageType":"electricity","dragonType":"bronze","tradition":"arcane"}},{"label":"PF2E.Dragon.Copper","value":{"damageType":"acid","dragonType":"copper","tradition":"arcane"}},{"label":"PF2E.Dragon.Gold","value":{"damageType":"fire","dragonType":"gold","tradition":"arcane"}},{"label":"PF2E.Dragon.Green","value":{"damageType":"poison","dragonType":"green","tradition":"arcane"}},{"label":"PF2E.Dragon.Silver","value":{"damageType":"cold","dragonType":"silver","tradition":"arcane"}},{"label":"PF2E.Dragon.Red","value":{"damageType":"fire","dragonType":"red","tradition":"arcane"}},{"label":"PF2E.Dragon.White","value":{"damageType":"cold","dragonType":"white","tradition":"arcane"}}],"flag":"dragon","key":"ChoiceSet","prompt":"PF2E.SpecificRule.DragonDisciple.Prompt"}'
