    Uuid: 
    Json: '{"itemType":"spell","key":"ItemAlteration","mode":"add","predicate":[{"not":"parent:granter:slug:crossblooded-evolution"},{"or":[{"and":["item:trait:focus","item:trait:sorcerer"]},{"and":["item:spell-slot","spellcasting:category:spontaneous","spellcasting:tradition:primal",{"or":["item:slug:resist-energy","item:slug:unfettered-movement","item:slug:elemental-form","item:slug:energy-aegis","item:slug:earthquake","item:slug:wrathful-storm",{"and":["feature:bloodline:elemental:air",{"or":["item:slug:tailwind","item:slug:wall-of-wind","item:slug:chain-lightning"]}]},{"and":["feature:bloodline:elemental:earth",{"or":["item:slug:pummeling-rubble","item:slug:earthbind","item:slug:petrify"]}]},{"and":["feature:bloodline:elemental:fire",{"or":["item:slug:breathe-fire","item:slug:fireball","item:slug:tree-of-seasons"]}]},{"and":["feature:bloodline:elemental:metal",{"or":["item:slug:thunderstrike","item:slug:lightning-bolt","item:slug:chain-lightning"]}]},{"and":["feature:bloodline:elemental:water",{"or":["item:slug:hydraulic-push","item:slug:aqueous-orb","item:slug:scintillating-safeguard"]}]},{"and":["feature:bloodline:elemental:wood",{"or":["item:slug:cleanse-cuisine","item:slug:wall-of-thorns","item:slug:tangling-creepers"]}]}]}]}]}],"priority":121,"property":"other-tags","value":"blood-magic-spell"}'
