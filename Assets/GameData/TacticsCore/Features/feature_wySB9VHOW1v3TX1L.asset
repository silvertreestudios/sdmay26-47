    Path: system.resources.crafting.infusedReagents.max
    Mode: upgrade
    Value: '"@actor.level + @actor.abilities.int.mod"'
    Uuid: 
    Json: '{"key":"ActiveEffectLike","mode":"upgrade","path":"system.resources.crafting.infusedReagents.max","predicate":["class:alchemist"],"value":"@actor.level
      + @actor.abilities.int.mod"}'
  - Key: ActiveEffectLike
